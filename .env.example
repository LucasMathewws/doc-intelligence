# Copie para .env e ajuste se quiser. Todos os valores abaixo tem default no codigo
# (src/config.ts) — .env e opcional para rodar localmente.

PORT=3000

# Placeholder de autenticacao servico-a-servico (ADR 0006). Trocar em producao.
API_KEY=dev-local-key

# Onde a fatia vertical persiste dados (JSON + blobs). ADR 0002.
DATA_DIR=./data

# Confianca minima (0..1) para um documento sair como "ready" sem revisao humana. ADR 0004.
CONFIDENCE_THRESHOLD=0.8

# Quantas chamadas ao classificador o worker deixa em voo ao mesmo tempo. Fato do ambiente (e).
MAX_CONCURRENT_LLM_CALLS=5

# Intervalo do worker loop, em ms.
WORKER_INTERVAL_MS=500

# Tentativas antes de marcar um documento como "failed". ADR 0001.
MAX_ATTEMPTS=3

# Atraso simulado (ms) do classificador dublê, para parecer com uma chamada real (fato a: 5-40s
# no mundo real). Default baixo para nao deixar a demonstracao manual lenta.
LLM_STUB_DELAY_MS=800

# Tamanho maximo de upload aceito, em bytes. Default: 15MB.
MAX_UPLOAD_BYTES=15728640

# Tempo maximo (ms) esperando o classificador antes de tratar como falha e tentar de novo. Fato do
# ambiente (a): a chamada "de vez em quando... simplesmente nao responde" — sem teto, isso trava um
# slot de concorrencia do worker para sempre. Default acima do teto documentado de 40s.
LLM_CALL_TIMEOUT_MS=45000
